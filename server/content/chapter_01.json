{
  "id": "chapter_01",
  "title": "Часовая площадь",
  "levelWidth": 7200,
  "playerStart": 260,
  "intro": [
    {
      "type": "text",
      "text": {
        "low": "Завтра Петька идёт в школу.",
        "mid": "Завтра Петька идёт в школу. В портфель он сложил тетрадь и яблоко.",
        "high": "Завтра первое сентября. Петька сложил в портфель тетрадь, пенал и большое яблоко."
      }
    },
    {
      "type": "text",
      "text": {
        "low": "Из тетради вылезла Клякса.",
        "mid": "Вдруг из тетради вылезла Клякса. Она утащила все цифры.",
        "high": "Вдруг из тетради вылезла Клякса. Она фыркнула, надулась и утащила из города все цифры."
      }
    },
    {
      "type": "text",
      "text": {
        "low": "Часы встали. Автобус не поехал.",
        "mid": "Часы на башне встали. Автобус не поехал. Пекарь не смог сосчитать булки.",
        "high": "Часы на башне встали, автобус не поехал, а пекарь не смог сосчитать булки: без цифр город не работает."
      }
    },
    {
      "type": "text",
      "text": {
        "low": "«Я верну цифры», - сказал Петька.",
        "mid": "«Я верну все цифры», - сказал Петька. Рядом сел кот Тишка.",
        "high": "«Ну уж нет, - сказал Петька. - Я верну их все, до одной». Рядом сел кот Тишка и мяукнул."
      }
    },
    {
      "type": "cast",
      "title": "Кто есть кто",
      "cast": [
        {
          "frame": "petka_big",
          "name": "Петька",
          "role": "герой",
          "text": "Хочет вернуть цифры. Смелый и добрый."
        },
        {
          "frame": "cat_big",
          "name": "Кот Тишка",
          "role": "друг",
          "text": "Идёт рядом. Скажет, куда идти."
        },
        {
          "frame": "owl_read_big",
          "name": "Сова Ольга Петровна",
          "role": "учит",
          "text": "Хранит Числовую книгу. Знает про числа всё."
        },
        {
          "frame": "baker_tray_big",
          "name": "Пекарь",
          "role": "печёт булки",
          "text": "Без цифр не знает, сколько печь булок."
        },
        {
          "frame": "klyaksa_big",
          "name": "Клякса",
          "role": "вредина",
          "text": "Она украла цифры. Не подходи к ней!"
        }
      ]
    },
    {
      "type": "learn",
      "title": "Это цифры",
      "text": {
        "low": "Цифра - это значок.",
        "mid": "Цифра - это значок. Им пишут, сколько чего.",
        "high": "Цифра - это значок, которым записывают число. Число отвечает на вопрос «сколько»."
      },
      "digits": [
        {
          "frame": "digit_0",
          "label": "ноль"
        },
        {
          "frame": "digit_1",
          "label": "один"
        },
        {
          "frame": "digit_2",
          "label": "два"
        },
        {
          "frame": "digit_3",
          "label": "три"
        }
      ],
      "note": {
        "low": "Цифр всего десять.",
        "mid": "Цифр всего десять. Из них можно составить любое число.",
        "high": "Цифр всего десять, от нуля до девяти, а чисел из них - сколько угодно."
      }
    },
    {
      "type": "learn",
      "title": "Считаем до пяти",
      "text": "Считай вслух вместе с Петькой.",
      "digits": [
        {
          "frame": "digit_1",
          "label": "один"
        },
        {
          "frame": "digit_2",
          "label": "два"
        },
        {
          "frame": "digit_3",
          "label": "три"
        },
        {
          "frame": "digit_4",
          "label": "четыре"
        },
        {
          "frame": "digit_5",
          "label": "пять"
        }
      ],
      "note": {
        "low": "Цифры в городе надо найти.",
        "mid": "В городе цифры надо найти и вернуть на место.",
        "high": "В городе цифры надо найти, узнать среди трёх трафаретов и вернуть на место."
      }
    },
    {
      "type": "scene",
      "frame": "cat_big",
      "name": "Кот Тишка",
      "text": "Иди вправо. Нажимай стрелку или D.",
      "keys": [
        {
          "cap": "→ D",
          "text": "идти"
        }
      ]
    },
    {
      "type": "scene",
      "frame": "petka_walk_big",
      "text": {
        "low": "Прыгай стрелкой вверх.",
        "mid": "Прыгать умеешь? Нажми стрелку вверх.",
        "high": "Прыгать умеешь? Нажми стрелку вверх или W - Петька прыгает высоко."
      },
      "keys": [
        {
          "cap": "↑ W",
          "text": "прыжок"
        }
      ]
    },
    {
      "type": "scene",
      "frame": "owl_point_big",
      "name": "Сова Ольга Петровна",
      "text": "Увидел цифру - подойди к ней. Откроется окошко."
    },
    {
      "type": "scene",
      "frame": "owl_read_big",
      "name": "Сова Ольга Петровна",
      "text": "В окошке найди такую же цифру и перетащи её туда."
    },
    {
      "type": "scene",
      "frame": "baker_talk_big",
      "name": "Пекарь",
      "text": "Хочешь поговорить со мной? Нажми E.",
      "keys": [
        {
          "cap": "пробел",
          "text": "говорить"
        }
      ]
    },
    {
      "type": "scene",
      "frame": "klyaksa_big",
      "name": "Клякса",
      "flip": true,
      "text": "А меня обходи! Я пачкаю портфель."
    },
    {
      "type": "scene",
      "frame": "baker_tray_big",
      "name": "Пекарь",
      "text": {
        "low": "Ящик не пускает? Реши задачу.",
        "mid": "Дорогу закрыл ящик? Нажми пробел и реши задачу.",
        "high": "Дорогу закрыл ящик? Нажми пробел и реши задачу - ящик сам уедет."
      },
      "keys": [
        {
          "cap": "пробел",
          "text": "решить"
        }
      ]
    }
  ],
  "hint": {
    "low": "Собери цифры. Иди: A и D. Прыжок: стрелка вверх. Пробел - говорить.",
    "mid": "Собери все цифры. Иди: A и D. Прыгай стрелкой вверх. Пробел - поговорить и решить.",
    "high": "Собери все цифры и верни их на место. Иди: A и D, прыжок - стрелка вверх, пробел - поговорить с героем или решить задачу у ящика. Кляксу обходи."
  },
